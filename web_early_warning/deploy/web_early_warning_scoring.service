[Unit]
Description=Web Threat Early Warning - Scoring API (FastAPI/Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/web_early_warning_scoring.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=__ROOT_DIR__

User=__SERVICE_USER__
Group=__SERVICE_GROUP__

ExecStart=__ROOT_DIR__/.venv/bin/uvicorn web_early_warning.inference_service:app --host ${HOST} --port ${PORT}

Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
